# ============================================
# .env — copie esse arquivo pra .env e preencha
# ============================================

# Sentry — pegue em Settings → Projects → seu_projeto → Client Keys (DSN)
SENTRY_DSN=https://xxxxxxxxxxxx@oXXXXXX.ingest.us.sentry.io/XXXXXX
SENTRY_ENVIRONMENT=demo

# Sentry Webhook Secret — opcional, deixa vazio pra demo
# Em Settings → Developer Settings → New Internal Integration → Webhook
SENTRY_CLIENT_SECRET=

# LLM Provider — "claude" ou "openai"
LLM_PROVIDER=claude

# Claude (Anthropic) — pegue em https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
CLAUDE_MODEL=claude-opus-4-8

# OpenAI (caso queira trocar) — pegue em https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Onde criar o card — "github" (default, mais visual pra demo) ou "jira"
ISSUE_PROVIDER=github

# GitHub — pegue em https://github.com/settings/tokens (PAT classic com escopo `repo`)
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_REPO=william-alves/sentry-ai-demo

# Assignar a issue pro GitHub Copilot Coding Agent gerar PR draft (true/false).
# Default false: o Copilot leva ~minutos, então deixe off pra não atrapalhar a demo ao vivo.
ENABLE_COPILOT_ASSIGN=false

# Jira (só quando ISSUE_PROVIDER=jira) — token em https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://suaempresa.atlassian.net
JIRA_EMAIL=seu-email@dominio.com
JIRA_TOKEN=ATATT3xFfGF0xxxxxxxxxxxx
JIRA_PROJECT=KAN
JIRA_ISSUE_TYPE=Task

# App
APP_PORT=8000
